# ==================================================
# PROXY AND DISPATCHER
# ==================================================
PROXY_EXPOSED_PORT=8080
PROXY_PATH_PREFIX=/remora/
PROXY_REQUEST_TIMEOUT=10
DISPATCHER_MAX_ACCEPTED_REQUESTS=128
DISPATCHER_MAX_CONCURRENT_REQUESTS=64
DISPATCHER_CAN_CACHE_CONTENT=false
DISPATCHER_SPECIAL_ENDPOINT_PREFIX=r


# ==================================================
# REGISTRIES AND PERSISTENCE
# ==================================================
REGISTRY_TYPE=mongo
REGISTRY_API_TYPE=embedded
REGISTRY_CONNECTION_STRING="mongodb://localhost:27017"
TIDAL_MINNOW_PROFILES_UPDATE_POLLING_SECONDS=60
REGISTRY_LOAD_ALL_PROFILES_AT_STARTUP=true


# ==================================================
# LOGGING STRATEGIES (trace, debug, info, warn, error, fatal, panic, disabled)
# ==================================================
HARBOR_DISPATCHER_LOGGING_LEVEL=trace
HARBOR_PROXY_LOGGING_LEVEL=trace